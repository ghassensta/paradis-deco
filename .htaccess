<IfModule mod_rewrite.c>
Options +FollowSymLinks
RewriteEngine On

# Fichier de verification Google Search Console (reste a la racine)
RewriteRule ^google86e093cf9edfd147\.html$ - [L]

# Page d accueil
RewriteRule ^$ public/index.php [L]

# Tout le reste passe par public/ : les fichiers du projet (.env, storage/logs, vendor, composer.json...) ne sont plus servis
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
